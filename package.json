{
  "name": "reading-habit-tracker",
  "version": "1.3.0",
  "type": "commonjs",
  "description": "A web application to track reading habits using Goodreads export data",
  "main": "server.js",
  "scripts": {
    "build": "cd client && npm run build",
    "start": "node server.js",
    "dev": "NODE_ENV=development nodemon server.js",
    "client": "cd client && npm start",
    "install-client": "cd client && npm ci",
    "lint": "eslint .",
    "test": "jest",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:live": "node e2e/warn-live.mjs && MYBOOKS_BASE_URL=https://mybooks.piapps.dev playwright test --project=chromium"
  },
  "author": "hexawulf",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "connect-mongo": "^5.1.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dayjs": "^1.11.13",
    "dotenv": "^18.0.10",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.4",
    "express-session": "^1.18.1",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.3.0",
    "mongoose": "^8.9.0",
    "multer": "^1.4.5-lts.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "jest": "^29.6.1",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "overrides": {
    "nodemon": {
      "minimatch": "^11.0.9"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
